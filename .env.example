# ===== youtube-media-company — ambiente isolado =====
# Porta propria (nao colide com outros projetos)
PORT=3777
HOST=127.0.0.1
# Chave exigida em toda requisicao de escrita quando HOST != 127.0.0.1
API_KEY=

# ----- Orcamento de despesa externa -----
# ZERO = nenhuma chamada paga permitida. Alterar exige autorizacao do proprietario.
EXTERNAL_SPEND_LIMIT_USD=0

# ----- Texto (opcional; piloto roda em modo assistido sem nada disso) -----
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ----- Narracao -----
# local_kokoro = TTS local, zero custo (padrao). Nao ha fallback pago sem autorizacao.
TTS_PROVIDER=local_kokoro
TTS_PYTHON=/opt/ymc-tts/bin/python
TTS_VOICE=am_michael

# ----- Render -----
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_FPS=30
RENDER_CRF=22
RENDER_PRESET=medium

# ----- YouTube (vazio = publicacao e analytics BLOQUEADOS) -----
# Passo a passo em docs/youtube-oauth.md. O login acontece no SEU navegador.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:3777/api/youtube/oauth/callback
DEFAULT_PRIVACY_STATUS=private
# Tamanho do pedaco no upload retomavel (multiplo de 256 KiB)
YT_UPLOAD_CHUNK_BYTES=8388608

# ----- Seguranca -----
# Chave de 64 hex para cifrar tokens em repouso. Vazio = gerada em var/tokens/.key (0600).
# TOKEN_ENCRYPTION_KEY=
# Expor o painel fora de 127.0.0.1 exige API_KEY de 32+ caracteres E uma destas:
# TLS_TERMINATED=1      # ha HTTPS na frente (nginx, caddy, tunel)
# ALLOW_REMOTE_HTTP=1   # rede local controlada, por sua conta e risco
